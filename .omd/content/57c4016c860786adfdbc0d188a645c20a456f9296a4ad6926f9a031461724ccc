import { execFile } from "node:child_process";
import { promisify } from "node:util";
import { realpath } from "node:fs/promises";
import type { ExtensionAPI, ExtensionCommandContext, ExtensionContext } from "@earendil-works/pi-coding-agent";
import { captureSnapshot } from "./context.ts";
import { ReviewLedger, REVIEW_LIMITS } from "./ledger.ts";
import type { ReviewState } from "./ledger.ts";
import { ManagedSkillStore } from "./store.ts";
import { reviewSkills } from "./review.ts";

export function reviewStatus(state: ReviewState, sessionId: string) {
  const day = [state.lastDay, new Date().toISOString().slice(0, 10)].sort().at(-1)!;
  const charged = state.records.filter(r => r.status !== "skipped" && (r.day === day || r.usageUnknown));
  const latest = state.records.at(-1);
  const errors = state.records.filter(r => (r.status === "failed" || r.usageUnknown) && !(state.acknowledged ?? []).includes(r.id));
  const sum = (field: "input" | "output" | "cacheRead" | "cacheWrite") => charged.reduce((n, r) => n + (r.usage?.[field] ?? 0), 0);
  return {
    auto: "off (scheduler not enabled)", paused: state.paused, latest: latest?.status ?? "idle",
    errors: errors.length, jobs: charged.length, jobLimit: REVIEW_LIMITS.dailyJobs,
    input: sum("input"), output: sum("output"), cacheRead: sum("cacheRead"), cacheWrite: sum("cacheWrite"),
    unresolvedInput: charged.filter(r => r.usageUnknown).reduce((n, r) => n + r.reservation.input, 0),
    unresolvedOutput: charged.filter(r => r.usageUnknown).reduce((n, r) => n + r.reservation.output, 0),
    auxSessionTokens: state.records.filter(r => r.sessionId === sessionId).reduce((n, r) => n + (r.usage?.totalTokens ?? 0), 0),
    pricesUnknown: charged.filter(r => r.costUnknown).length,
  };
}

/** UI is a subscriber to durable state, never the budget authority. */
export function registerReviewUI(pi: ExtensionAPI, agentDir: string): void {
  const ledger = new ReviewLedger(agentDir);
  let ctx: ExtensionContext | undefined;
  let state: ReviewState | undefined;
  let unsubscribe: (() => void) | undefined;
  let unsubscribeEvents: (() => void) | undefined;
  let controller: AbortController | undefined;
  let running: Promise<unknown> | undefined;
  let timer: ReturnType<typeof setInterval> | undefined;
  let generation = 0;
  let lastPrinted = "";

  const render = () => {
    if (!ctx || !state) return;
    const status = reviewStatus(state, ctx.sessionManager.getSessionId());
    const active = state.records.find(r => r.status === "running" || r.status === "admitted");
    const elapsed = active ? ` ${active.model} ${Math.max(0, Math.floor((Date.now() - active.started) / 1000))}s` : "";
    const reserved = status.unresolvedInput || status.unresolvedOutput ? ` | usage UNKNOWN reserved ${status.unresolvedInput}/${status.unresolvedOutput}` : "";
    const title = `Hermes auto OFF | ${status.paused ? "PAUSED " + status.paused : status.latest}${elapsed} | errors ${status.errors}`;
    const detail = `jobs ${status.jobs}/${status.jobLimit} | input ${status.input}/${REVIEW_LIMITS.dailyInput} output ${status.output}/${REVIEW_LIMITS.dailyOutput} cache ${status.cacheRead}/${status.cacheWrite}${reserved} | price ${status.pricesUnknown ? "UNKNOWN" : "reported"}`;
    if (ctx.mode === "tui") {
      ctx.ui.setStatus("hermes-review", title);
      ctx.ui.setWidget("hermes-review", [title, detail, "/hermes-review status | usage | errors | cancel | retry | pause | resume"]);
    } else {
      const text = JSON.stringify({ type: "hermes.review.status", ...status });
      if (text !== lastPrinted) { lastPrinted = text; console.error(text); }
    }
  };
  const fault = (error: unknown) => {
    const message = `Hermes ledger unavailable: ${String(error).slice(0, 400)}; model calls blocked`;
    if (ctx?.mode === "tui") {
      ctx.ui.setStatus("hermes-review", "Hermes PAUSED: ledger error");
      ctx.ui.setWidget("hermes-review", [message]);
    } else console.error(JSON.stringify({ type: "hermes.review.fault", message }));
  };
  const refresh = async () => { try { state = await ledger.inspect(); render(); } catch (error) { fault(error); throw error; } };
  const cancel = () => { generation++; controller?.abort(new Error("user-or-session-cancelled")); };
  const detail = (value: unknown) => {
    const text = JSON.stringify(value, null, 2);
    if (ctx?.mode === "tui" || ctx?.mode === "rpc") ctx.ui.notify(text, "info");
    else console.error(JSON.stringify({ type: "hermes.review.detail", data: value }));
  };

  const projectRoot = async (command: ExtensionCommandContext): Promise<string> => {
    if (!command.isProjectTrusted()) throw new Error("Project is not trusted; review cannot write project knowledge");
    try {
      const result = await promisify(execFile)("git", ["-C", command.cwd, "rev-parse", "--show-toplevel"]);
      return await realpath(result.stdout.trim());
    } catch {
      if (command.mode !== "tui") throw new Error("Non-Git project needs an explicitly selected root in TUI");
      const selected = await command.ui.input("Select this non-Git project's root", command.cwd);
      if (!selected) throw new Error("No project root selected");
      return await realpath(selected);
    }
  };
  const run = async (command: ExtensionCommandContext, retryOf?: string) => {
    if (running) throw new Error("A review is already active");
    if (!command.model) throw new Error("No selected model");
    if (!command.isIdle()) throw new Error("Finish the foreground run before requesting review");
    await refresh();
    if (state?.paused && !retryOf) throw new Error(`Review paused: ${state.paused}; inspect errors and explicitly resume`);
    const snapshot = captureSnapshot(command);
    if (retryOf) {
      const prior = state?.records.find(r => r.id === retryOf);
      if (!prior || prior.digest !== snapshot.digest || prior.sessionId !== snapshot.sessionId || prior.model !== command.model.id || prior.provider !== command.model.provider) {
        throw new Error("Retry requires the original snapshot and selected model; use run for new work");
      }
      if (!command.hasUI) throw new Error("Retry requires an explicit interactive budget confirmation");
      if (!await command.ui.confirm("Retry one metered request?", JSON.stringify({ old: prior, limits: REVIEW_LIMITS, remaining: reviewStatus(state!, snapshot.sessionId) }))) return;
    }
    const root = await projectRoot(command);
    const ownGeneration = generation;
    const ownController = new AbortController(); controller = ownController;
    const task = reviewSkills({ snapshot, registry: command.modelRegistry, ledger,
      store: new ManagedSkillStore(agentDir, root), signal: ownController.signal,
      retryOf, isCurrent: () => generation === ownGeneration });
    running = task;
    timer = setInterval(render, 1000);
    void task.then(() => refresh(), async error => { fault(error); await refresh().catch(() => {}); })
      .catch(error => { fault(error); })
      .finally(() => { running = undefined; controller = undefined; clearInterval(timer); timer = undefined; });
  };

  pi.registerCommand("hermes-review", {
    description: "Metered review: run/status/usage/errors/cancel/retry/pause/resume",
    handler: async (args, command) => {
      ctx = command;
      const [action = "status", value] = args.trim() ? args.trim().split(/\s+/) : [];
      try {
        await refresh();
        switch (action) {
          case "run": await run(command); break;
          case "status": detail(reviewStatus(state!, command.sessionManager.getSessionId())); break;
          case "usage": {
            const primary = command.sessionManager.getEntries().reduce((n, e) => e.type === "message" && "usage" in e.message ? n + (e.message.usage?.totalTokens ?? 0) : n, 0);
            const summary = reviewStatus(state!, command.sessionManager.getSessionId());
            detail({ primaryRecordedTokens: primary, auxiliarySessionTokens: summary.auxSessionTokens,
              recordedSessionTotal: primary + summary.auxSessionTokens, unknownAuxiliaryExcluded: state!.records.some(r => r.usageUnknown),
              scope: "recorded session, not a verified bill; daily auxiliary quota is separate", daily: summary, records: state!.records });
            break;
          }
          case "errors": detail(state!.records.filter(r => r.status === "failed" || r.usageUnknown)); break;
          case "cancel": cancel(); break;
          case "pause": cancel(); await ledger.pause(); break;
          case "resume":
            if (command.hasUI) {
              if (!await command.ui.confirm("Acknowledge review failures and clear pause?", JSON.stringify({ state, notice: "Unknown reservations remain charged. Automatic scheduling is still disabled." }))) break;
            } else if (value !== "--acknowledge") throw new Error("Inspect errors, then use resume --acknowledge; unknown reservations are retained");
            await ledger.resume(); break;
          case "retry": {
            const id = value ?? state!.records.filter(r => r.status !== "skipped").at(-1)?.id;
            if (!id) throw new Error("No completed request to retry");
            await run(command, id); break;
          }
          default: throw new Error("Use run/status/usage/errors/cancel/retry/pause/resume");
        }
        if (action !== "run" && action !== "retry") await refresh();
      } catch (error) {
        detail({ failed: String(error), modelCalled: false, automaticReview: "off" });
        if (!state) fault(error);
      }
    },
  });
  pi.on("session_start", async (_event, context) => {
    ctx = context; unsubscribe?.(); unsubscribe = ledger.subscribe(value => { state = value; render(); });
    unsubscribeEvents?.();
    unsubscribeEvents = pi.events.on("hermes.review.v1", event => {
      if (event && typeof event === "object" && "type" in event && event.type === "status-changed") {
        void refresh().catch(() => {});
      }
    });
    await refresh().catch(() => {});
  });
  pi.on("input", () => { cancel(); });
  pi.on("session_tree", () => { cancel(); });
  pi.on("session_before_switch", () => { cancel(); });
  pi.on("session_before_fork", () => { cancel(); });
  pi.on("session_shutdown", () => { cancel(); unsubscribe?.(); unsubscribeEvents?.(); clearInterval(timer); timer = undefined; });
}
